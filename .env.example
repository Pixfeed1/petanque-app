# ===================================
# CONFIGURATION POSTGRESQL
# ===================================

# Informations de connexion à votre base PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=petanque
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here

# ===================================
# AUTHENTIFICATION JWT
# ===================================

# Clé secrète pour signer les tokens JWT
# ⚠️ OBLIGATOIRE ET CRITIQUE POUR LA SÉCURITÉ
# Doit contenir au moins 32 caractères
#
# Génération d'une clé sécurisée:
#   Linux/Mac: openssl rand -base64 32
#   Windows: PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
#
# ❌ NE JAMAIS utiliser la valeur par défaut en production
# ❌ NE JAMAIS commiter cette valeur dans Git
JWT_SECRET=

# ===================================
# STRIPE (Paiements)
# ===================================

# Clés Stripe pour les paiements Premium
# Récupérez-les sur https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Webhook secret pour valider les événements Stripe
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ===================================
# GOOGLE ADSENSE (Publicités)
# ===================================

# Client ID Google AdSense (pour les utilisateurs gratuits)
# Récupérez-le sur https://www.google.com/adsense
# Format: ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-your_client_id_here

# ===================================
# APPLICATION
# ===================================

# URL de base de l'application (pour les redirections)
NEXT_PUBLIC_APP_URL=https://petanquepro.fr

# Mode environnement
NODE_ENV=development

# ===================================
# EMAIL / SMTP (Réinitialisation mot de passe)
# ===================================

# Configuration du serveur SMTP pour l'envoi d'emails
# Par défaut: localhost (si vous avez Postfix/Sendmail installé sur le VPS)
SMTP_HOST=localhost
SMTP_PORT=25

# Authentification SMTP (optionnel, si votre serveur SMTP le requiert)
# Laissez vide si vous utilisez localhost sans authentification
SMTP_USER=
SMTP_PASS=

# Adresse email d'envoi
SMTP_FROM=noreply@petanquepro.fr

# ===================================
# SYSTÈME D'AVIS (Reviews)
# ===================================

# Emails des administrateurs (séparés par des virgules)
# Ces utilisateurs peuvent modérer les avis via /admin/reviews
ADMIN_EMAILS=admin@petanquepro.fr,contact@petanquepro.fr

# Secret pour sécuriser les endpoints de synchronisation des stores
# Générez une clé aléatoire sécurisée
SYNC_SECRET=your_sync_secret_change_this_in_production

# Google Play Store (à configurer quand l'app sera sur Google Play)
# Laissez vide pour l'instant - le système restera dormant
GOOGLE_PLAY_APP_ID=
GOOGLE_PLAY_API_KEY=

# Apple App Store (à configurer quand l'app sera sur App Store)
# Laissez vide pour l'instant - le système restera dormant
APP_STORE_APP_ID=
APP_STORE_TOKEN=

# ===================================
# NOTES POUR LE DÉPLOIEMENT SUR VPS
# ===================================

# 1. Installez PostgreSQL sur votre VPS :
#    sudo apt update
#    sudo apt install postgresql postgresql-contrib
#
# 2. Créez la base de données :
#    sudo -u postgres createdb petanque
#    sudo -u postgres psql petanque < database/schema.sql
#
# 3. Créez un utilisateur PostgreSQL :
#    sudo -u postgres createuser --interactive --pwprompt
#
# 4. Configurez PostgreSQL pour accepter les connexions :
#    Éditez /etc/postgresql/*/main/pg_hba.conf
#    Ajoutez : host all all 0.0.0.0/0 md5
#
# 5. Redémarrez PostgreSQL :
#    sudo systemctl restart postgresql
#
# 6. Copiez ce fichier en .env.local et remplissez les vraies valeurs
#
# 7. Générez un JWT_SECRET sécurisé :
#    openssl rand -base64 32
#
# 8. Configuration SMTP pour l'envoi d'emails :
#    Option A - Serveur SMTP local (Postfix) :
#      sudo apt install postfix
#      Configurez en mode "Internet Site"
#      Utilisez SMTP_HOST=localhost et SMTP_PORT=25
#
#    Option B - Service externe (Gmail, SendGrid, etc.) :
#      Configurez SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS
#      Exemple Gmail: smtp.gmail.com:587 avec un mot de passe d'application
