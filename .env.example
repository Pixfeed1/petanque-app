# ===================================
# CONFIGURATION POSTGRESQL
# ===================================

# Informations de connexion à votre base PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=petanque
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here

# ===================================
# AUTHENTIFICATION JWT
# ===================================

# Clé secrète pour signer les tokens JWT
# IMPORTANT: Générez une clé aléatoire sécurisée en production
# Exemple de génération: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_key_change_this_in_production

# ===================================
# STRIPE (Paiements)
# ===================================

# Clés Stripe pour les paiements Premium
# Récupérez-les sur https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Webhook secret pour valider les événements Stripe
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ===================================
# APPLICATION
# ===================================

# URL de base de l'application (pour les redirections)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mode environnement
NODE_ENV=development

# ===================================
# NOTES POUR LE DÉPLOIEMENT SUR VPS
# ===================================

# 1. Installez PostgreSQL sur votre VPS :
#    sudo apt update
#    sudo apt install postgresql postgresql-contrib
#
# 2. Créez la base de données :
#    sudo -u postgres createdb petanque
#    sudo -u postgres psql petanque < database/schema.sql
#
# 3. Créez un utilisateur PostgreSQL :
#    sudo -u postgres createuser --interactive --pwprompt
#
# 4. Configurez PostgreSQL pour accepter les connexions :
#    Éditez /etc/postgresql/*/main/pg_hba.conf
#    Ajoutez : host all all 0.0.0.0/0 md5
#
# 5. Redémarrez PostgreSQL :
#    sudo systemctl restart postgresql
#
# 6. Copiez ce fichier en .env.local et remplissez les vraies valeurs
#
# 7. Générez un JWT_SECRET sécurisé :
#    openssl rand -base64 32

# ===================================
# OAUTH - GOOGLE
# ===================================

# Configuration OAuth Google
# 1. Allez sur https://console.cloud.google.com/
# 2. Créez un nouveau projet ou sélectionnez-en un
# 3. Activez l'API Google+ (Google+ API)
# 4. Allez dans "Identifiants" > "Créer des identifiants" > "ID client OAuth 2.0"
# 5. Configurez l'écran de consentement OAuth
# 6. Ajoutez les URI de redirection autorisées :
#    - http://localhost:3000/api/auth/oauth/google/callback (développement)
#    - https://votredomaine.com/api/auth/oauth/google/callback (production)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/oauth/google/callback

# ===================================
# OAUTH - FACEBOOK
# ===================================

# Configuration OAuth Facebook
# 1. Allez sur https://developers.facebook.com/
# 2. Créez une nouvelle application
# 3. Allez dans "Paramètres" > "De base"
# 4. Activez "Connexion Facebook"
# 5. Dans "Paramètres de connexion Facebook", ajoutez les URI de redirection OAuth valides :
#    - http://localhost:3000/api/auth/oauth/facebook/callback (développement)
#    - https://votredomaine.com/api/auth/oauth/facebook/callback (production)
FACEBOOK_APP_ID=your_facebook_app_id_here
FACEBOOK_APP_SECRET=your_facebook_app_secret_here
FACEBOOK_REDIRECT_URI=http://localhost:3000/api/auth/oauth/facebook/callback
